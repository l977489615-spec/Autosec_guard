# ─────────────────────────────────────────────────────────────────────────────
# AutoSec Guard – ICV Vulnerability Scanner  |  环境变量配置示例
# 复制此文件为 .env，按实际部署情况填写。  敏感字段请勿提交到版本库。
# ─────────────────────────────────────────────────────────────────────────────

# ── 核心配置 ──────────────────────────────────────────────────
# JWT 签名密钥（生产环境必须使用随机长字符串）
# 生成方式：python3 -c "import secrets; print(secrets.token_hex(32))"
AUTOSEC_SECRET_KEY=replace_with_a_long_random_secret

# 数据库连接串（支持 SQLite / PostgreSQL）
# SQLite（本地边缘默认）：
AUTOSEC_DB_URI=sqlite:///server/autosec.db
# PostgreSQL 示例：
# AUTOSEC_DB_URI=postgresql+psycopg2://user:pass@localhost:5432/autosec

# 后端监听地址和端口
# 默认 127.0.0.1（仅本机访问，最安全）。
# 实验室局域网共享时改为 0.0.0.0，并同时开启 AUTOSEC_REQUIRE_AUTH=true
AUTOSEC_HOST=127.0.0.1
AUTOSEC_PORT=5002
AUTOSEC_DEBUG=false

# 前端请求的后端 API 地址（在 TLS 反向代理后面时改为 https://）
AUTOSEC_API=http://localhost:5002

# MCP 服务地址（可选，用于 AI 辅助分析功能）
MCP_SERVER=http://localhost:5003

# ── 安全强化 ──────────────────────────────────────────────────
# 认证强制模式：
#   false（默认）= 本地边缘工作站模式，执行端点 token 可选
#   true         = 多用户/网络部署模式，所有执行端点强制 JWT 认证
AUTOSEC_REQUIRE_AUTH=false

# CORS 允许的来源（逗号分隔，留空则允许所有来源 *，仅限本地开发）
# 生产环境示例：AUTOSEC_CORS_ORIGINS=https://your-domain.com
AUTOSEC_CORS_ORIGINS=

# ── 用户注册与 Bootstrap ─────────────────────────────────────
# 开放注册（已有管理员后是否允许自助注册；默认 false，由管理员创建账号）
# AUTOSEC_ALLOW_OPEN_REGISTRATION=false

# Bootstrap 模式（空库时如何创建首管理员）：
#   edge     = 允许 Web「系统初始化」页面创建首管理员（单机边缘默认）
#   cli_only = 禁止 Web bootstrap，须执行 flask create-admin（企业/网络部署推荐）
AUTOSEC_BOOTSTRAP_MODE=edge

# 可选：Web 初始化时要求携带此 token，防止抢注（留空则不校验）
# 生成方式：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# AUTOSEC_BOOTSTRAP_TOKEN=

# ── 并发与资源控制 ────────────────────────────────────────────
# 最大同时执行的 PoC 数量（超出后返回 429）
AUTOSEC_MAX_CONCURRENT_POCS=5

# PoC 沙箱 CPU 时间限制（秒），默认 60
# SANDBOX_CPU_SECONDS=60

# PoC 沙箱内存上限（MB），默认 256
# SANDBOX_MEMORY_MB=256

# PoC 沙箱输出大小上限（MB），默认 8
# SANDBOX_OUTPUT_MB=8

# ── 可选：包化边缘工作站发布版 ───────────────────────────────
# 未设置时，包化构建使用 OS 用户数据目录；源码开发模式保持 server/autosec.db
# AUTOSEC_DATA_DIR=/opt/autosec-guard-edge/data
