# ─────────────────────────────────────────────────────────────────────────────
# AutoSec Guard / 智驭安盾 — Git 忽略规则
# 原则：忽略构建产物、密钥、克隆库、Agent 工具链；
#       lab 论文/实验数据保留在本地（可手动提交），仅忽略临时目录与本地配置。
# ─────────────────────────────────────────────────────────────────────────────

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
server/logs/

# ── Node / Frontend build ─────────────────────────────────────
node_modules/
dist/
dist-ssr/
client/dist/
*.local

# ── Python runtime ────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
venv/
.venv/

# ── Editor / OS ───────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Secrets & local env ───────────────────────────────────────
.env
.env.*
!.env.example
claude_code_env.sh

# ── Local databases ───────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Build / packaging artifacts ───────────────────────────────
build/
tmp/
output/
*.zip
*.crash
*.stackdump
nuitka-crash-report.xml

server/.edge_build/
server/.edge_spec/
server/edge_dist/
server/.edge-agent-state.json
server/backups/

# ── Downloaded / cloned reference material (not product source) ─
server/public_poc_sources/
server/public_poc_resources/

# ── Media binaries (PoC samples, demos) ───────────────────────
*.mp4
*.mov
*.avi

# ── Cursor / Agent tooling (not product) ──────────────────────
.agents/
.cursor/
skills-lock.json

# ── Internal agent plans & scratch docs ───────────────────────
docs/superpowers/
docs/internal/

# ══════════════════════════════════════════════════════════════
# lab/ — 仅忽略临时目录、克隆工具与本机配置副本
# 论文数据、evidence、xlsx、paper 脚本均保留
# ══════════════════════════════════════════════════════════════
lab/tmp/
lab/pentestgpt_id4/
lab/lab/

# 本机实验配置副本（保留 *.template.json / *.template.csv）
lab/experiment_config.json
lab/experiment_config.full.json
lab/experiment_config.local.json
