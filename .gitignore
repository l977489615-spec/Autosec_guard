# ─────────────────────────────────────────────────────────────────────────────
# AutoSec Guard / 智驭安盾 — Git 忽略规则
# 原则：只跟踪产品系统源码（client / server / lab 实验套件脚本与模板）；
#       本地运行产物、论文数据、克隆参考库、Agent 工具链等不上传。
# ─────────────────────────────────────────────────────────────────────────────

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
server/logs/

# ── Node / Frontend build ─────────────────────────────────────
node_modules/
dist/
dist-ssr/
client/dist/
*.local

# ── Python runtime ────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
venv/
.venv/

# ── Editor / OS ───────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Secrets & local env ───────────────────────────────────────
.env
.env.*
!.env.example
claude_code_env.sh

# ── Local databases ───────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Build / packaging artifacts ───────────────────────────────
build/
tmp/
output/
*.zip
*.crash
*.stackdump
nuitka-crash-report.xml

server/.edge_build/
server/.edge_spec/
server/edge_dist/
server/.edge-agent-state.json
server/backups/

# ── Generated audit / readiness reports (not product source) ──
server/reports/

# ── Downloaded / cloned public PoC reference material ─────────
server/public_poc_sources/
server/public_poc_resources/

# ── Media binaries (PoC samples, demos) ───────────────────────
*.mp4
*.mov
*.avi

# ── Cursor / Agent tooling (not product) ──────────────────────
.agents/
.cursor/
skills-lock.json

# ── Internal agent plans & scratch docs ───────────────────────
docs/superpowers/
docs/internal/

# ══════════════════════════════════════════════════════════════
# lab/ — 实验数据采集套件
# 保留：README、run_experiment.py、mock 环境、模板、核心度量脚本
# 忽略：运行证据、论文数据集、本地配置、Excel 产出、论文专用脚本
# ══════════════════════════════════════════════════════════════

# 运行产物与证据归档
lab/evidence/
lab/tmp/
lab/table10_manifests/
lab/final_paper_data_strict/
lab/ground_truth/
lab/paper_data/
lab/paper_data_selected/
lab/pentestgpt_id4/
lab/lab/

# 本地实验配置（保留 *.template.json / *.template.csv）
lab/experiment_config.json
lab/experiment_config.full.json
lab/experiment_config.local.json
lab/can_test_records.csv

# Excel / 表格产出
lab/*.xlsx
lab/Book*.xlsx
lab/实验*.xlsx
lab/论文*.xlsx

# 论文写作与数据整理脚本（非平台系统代码）
lab/audit_paper_consistency.py
lab/build_final_strict_paper_dataset.py
lab/build_paper_dataset.py
lab/build_paper_workbook.py
lab/build_security41_condensed_paper.py
